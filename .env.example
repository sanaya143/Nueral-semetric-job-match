# Copy this file to `.env` in the same folder (setup.bat does this for you) and edit it.
# `.env` is git-ignored. Never commit a real key.
#
# Default is OFFLINE mode: deterministic extraction + local embeddings, no key needed, $0.

# --- run mode ---------------------------------------------------------------
# offline | openrouter
NSM_LLM_MODE=offline
# local | openrouter   (openrouter also needs NSM_EMBEDDING_MODEL below)
NSM_EMBEDDING_MODE=local

# --- OpenRouter (only needed when NSM_LLM_MODE=openrouter) -------------------
# Create your own key at https://openrouter.ai/keys and paste it after the "=".
# Tip: set a credit limit on the key in the OpenRouter dashboard as a second safety net.
NSM_OPENROUTER_API_KEY=

# Optional: restrict routing to these providers (comma-separated slugs).
# NSM_PROVIDER_ALLOWLIST=provider-a,provider-b

# --- cost caps (decisions D-018 / D-019) -------------------------------------
# NSM_CAP_PER_RUN_USD=0.20
# NSM_CAP_PER_CV_USD=0.003
# Hard stop for one CV: must fit extraction + one large-model escalation (~$0.012 worst case, ~$0.023 with
# the thinking reserve if a model refuses thinking-off)
# NSM_CAP_PER_CV_HARD_USD=0.024
# NSM_CAP_MONTHLY_USD=50

# --- models (no model is built in; LLM mode stays off until both tiers are set) ---
# Any OpenRouter model IDs (https://openrouter.ai/models), written as vendor/model.
# Small tier: CV extraction, verification of the top 50, search, report.
NSM_MODEL_SMALL=
# Large tier: re-labelling failed CV sections, job-description parsing, deep evaluation of the top 5.
NSM_MODEL_LARGE=
# Optional per-task overrides: NSM_MODEL_EXTRACT, NSM_MODEL_ESCALATE, NSM_MODEL_JD, NSM_MODEL_VERIFY,
# NSM_MODEL_DEEP, NSM_MODEL_REPORT, NSM_MODEL_SEARCH
# Embedding model for NSM_EMBEDDING_MODE=openrouter
# NSM_EMBEDDING_MODEL=
# Prices in USD per 1M tokens, used for the budget checks before each call:
#   {"vendor/model": [input, output, cache_read]}
# Models without a price are estimated at $5 / $25, which is safe but will block most calls
# under the per-CV cap, so set these from the model's page on openrouter.ai.
# NSM_MODEL_PRICES={"vendor/small-model": [0.10, 0.50, 0.01], "vendor/large-model": [2.00, 10.00, 0.20]}
# Set true only if your provider needs explicit prompt-cache hints on the system prompt.
# NSM_EXPLICIT_CACHE_CONTROL=false
# Bulk ingestion through ':batch' variants (50% cheaper, slower)
# NSM_USE_BATCH_VARIANTS=false

# --- host / origin guard -------------------------------------------------------
# Host names the API answers to, and extra browser origins allowed to write.
# On Azure add your app's host name, e.g. NSM_ALLOWED_HOSTS=nsm-api.azurewebsites.net
# NSM_ALLOWED_HOSTS=127.0.0.1,localhost
# NSM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database ---------------------------------------------------------------------
# Empty = local SQLite file in data/. For Azure Database for PostgreSQL:
# NSM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/nsm?sslmode=require
# NSM_DB_POOL_SIZE=5

# --- who can use which workspace ---------------------------------------------------
# none    = local only; the sidebar's Workspace box picks the workspace. Never expose this mode.
# api_key = each key belongs to one workspace. Make keys with: python scripts/make_api_key.py <workspace>
# entra   = Microsoft Entra ID bearer tokens; the workspace comes from a token claim.
# NSM_AUTH_MODE=none
# NSM_API_KEYS={"<sha256 of key>": "<workspace>"}
# NSM_OIDC_ISSUER=https://login.microsoftonline.com/<directory-id>/v2.0
# NSM_OIDC_AUDIENCE=api://<application-id>
# NSM_OIDC_TENANT_CLAIM=tid
# NSM_OIDC_TENANT_MAP={"<directory-id>": "<workspace>"}

# --- abuse limits (429 with Retry-After when exceeded; 0 = off) -----------------------
# NSM_RATE_LIMIT_PER_MINUTE=300
# NSM_WRITE_RATE_LIMIT_PER_MINUTE=60
# NSM_DAILY_UPLOAD_QUOTA=2000
# NSM_DAILY_MATCH_RUN_QUOTA=200

# --- OCR for scanned PDFs and image CVs ----------------------------------------------
# auto = bundled local engine (offline, $0); azure = Azure AI Document Intelligence; off
# NSM_OCR_ENGINE=auto
# NSM_OCR_MAX_PAGES=10
# NSM_AZURE_DOCINTEL_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# NSM_AZURE_DOCINTEL_KEY=
