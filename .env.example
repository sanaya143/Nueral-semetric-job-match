# Copy this file to `.env` in the same folder (D:\Learning\Project1\.env) and edit it.
# `.env` is git-ignored. Never commit a real key.
#
# Default is OFFLINE mode: deterministic extraction + local embeddings, no key needed, $0.

# --- run mode ---------------------------------------------------------------
# offline | openrouter
NSM_LLM_MODE=offline
# local | openrouter   (openrouter = baai/bge-m3, $0.01 per 1M tokens)
NSM_EMBEDDING_MODE=local

# --- OpenRouter (only needed when NSM_LLM_MODE=openrouter) -------------------
# Create your own key at https://openrouter.ai/keys and paste it after the "=".
# Tip: set a credit limit on the key in the OpenRouter dashboard as a second safety net.
NSM_OPENROUTER_API_KEY=

# Optional: restrict routing to these providers (comma-separated slugs).
# NSM_PROVIDER_ALLOWLIST=anthropic

# --- cost caps (decisions D-018 / D-019) -------------------------------------
# NSM_CAP_PER_RUN_USD=0.20
# NSM_CAP_PER_CV_USD=0.003
# Hard stop for one CV: must fit extraction + one Sonnet escalation (~$0.012 worst case, ~$0.023 with
# the thinking reserve if a model refuses thinking-off)
# NSM_CAP_PER_CV_HARD_USD=0.024
# NSM_CAP_MONTHLY_USD=50

# --- task -> model routing (IDs verified on openrouter.ai, 2026-11-05) ---------
# NSM_MODEL_EXTRACT=anthropic/claude-haiku-5.5
# NSM_MODEL_ESCALATE=anthropic/claude-sonnet-5.5
# NSM_MODEL_JD=anthropic/claude-sonnet-5.5
# NSM_MODEL_VERIFY=anthropic/claude-haiku-5.5
# NSM_MODEL_DEEP=anthropic/claude-sonnet-5.5
# Bulk ingestion through ':batch' variants (50% cheaper, slower)
# NSM_USE_BATCH_VARIANTS=false
